{
  "name": "tls-http",
  "version": "1.0.4",
  "description": "Advanced browser-like HTTP client for Node.js with fingerprinting, sessions, proxies, retries, and axios-style API.",
  "main": "src/index.js",
  "types": "src/types/index.d.ts",
  "type": "commonjs",

  "keywords": [
    "http",
    "https",
    "tls",
    "fetch",
    "request",
    "axios",
    "browser",
