    "fingerprint",
    "fingerprinting",
    "spoofing",
    "session",
    "cookie",
    "cookies",
    "proxy",
    "http2",
    "tls-client",
    "scraping",
    "scraper",
    "webscraping",
    "automation",
    "web-automation",
    "network",
    "request-client",
    "stealth",
    "headers",
    "browser-headers",
    "chrome",
    "firefox",
    "edge",
    "node-fetch",
    "undici",
    "cloudflare",
    "anti-bot",
    "retry",
    "keepalive",
    "websocket",
    "client",
    "api-client"
  ],

  "main": "src/index.js",

  "exports": {
    ".": {
      "require": "./src/index.js",
      "types": "./src/types/index.d.ts"
    },
    "./*": "./src/*"
  },

  "files": [
    "src",
    "README.md",
    "examples"
  ],

  "engines": {
    "node": ">=16"
  },

  "dependencies": {
    "axios": "^1.9.0",
    "axios-cookiejar-support": "^6.0.1",
    "form-data": "^4.0.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.5",
    "tough-cookie": "^5.0.0",
    "undici": "^7.0.0",
    "ws": "^8.13.0"
  }
}